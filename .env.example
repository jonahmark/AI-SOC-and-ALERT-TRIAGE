# AI-SOC authentication configuration template.
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Every value here is a placeholder or a safe default - no real secrets.

# --- Session behaviour -----------------------------------------------------
AI_SOC_SESSION_TTL_HOURS=12
AI_SOC_REMEMBER_ME_DAYS=14
# Inactivity expiry in minutes (0 disables). Applies to remember-me sessions
# too; the absolute TTL above still applies independently.
AI_SOC_SESSION_IDLE_MINUTES=60

# --- Password policy ---------------------------------------------------------
# Recent passwords (including the current one) that cannot be reused on
# password change or recovery reset.
AI_SOC_PASSWORD_HISTORY_SIZE=5

# --- Two-factor authentication (optional per account) ------------------------
# Fernet key used to encrypt TOTP secrets at rest. Generate ONE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to disable MFA enrolment (the UI states it is unavailable).
# Protect this key like the SMTP credential; rotating it invalidates existing
# enrolments (admin removal + re-enrolment is the recovery path).
AI_SOC_TOTP_KEY=
# AI_SOC_TOTP_CHALLENGE_TTL_MINUTES=5
# AI_SOC_TOTP_MAX_ATTEMPTS=5

# --- Breach-password screening (optional) ------------------------------------
# 1 = check new passwords against the HIBP range API using k-anonymity
# (only a 5-character SHA-1 prefix is sent; never the password/full hash).
# Requires outbound HTTPS. If the service is unreachable the check fails
# open and the outage is audited - it is never reported as a clean result.
AI_SOC_BREACH_SCREENING=0
# AI_SOC_BREACH_CHECK_TIMEOUT=5

# --- Password recovery / verification tokens --------------------------------
AI_SOC_RESET_TOKEN_TTL_MINUTES=30
AI_SOC_VERIFY_TOKEN_TTL_HOURS=24

# --- Brute-force protection --------------------------------------------------
AI_SOC_MAX_FAILED_ATTEMPTS=5

# --- Email delivery ----------------------------------------------------------
# off    = no delivery (UI documents the limitation; nothing is sent)
# outbox = DEVELOPMENT ONLY: messages written to results/mail_outbox/*.eml,
#          clearly labelled in the UI; no real email is sent
# smtp   = real delivery via a transactional provider configured below
AI_SOC_EMAIL_MODE=outbox

# Public base URL used inside recovery/verification links. Must be reachable
# by whoever opens the link (localhost only works on the server machine).
# LAN-only example: http://<this machine's LAN IP>:8501 — update it if the IP
# changes (DHCP) and restart. See docs/AUTHENTICATION.md "Deployment &
# reachability" for the firewall rule and the no-public-HTTP posture.
AI_SOC_APP_URL=http://localhost:8501

# --- Transactional provider (recommended for real use) -----------------------
# Pick ONE provider. The host/port/STARTTLS are filled in automatically; you
# only supply the account credentials and a verified sender. This is a single
# server-side sending credential — end users never see or share it.
#
#   sendgrid  smtp.sendgrid.net:587      USER = the literal word "apikey"
#                                       PASSWORD = your SendGrid API key
#   brevo     smtp-relay.brevo.com:587   USER = your Brevo account email
#                                       PASSWORD = your Brevo SMTP key
#   mailgun   smtp.mailgun.org:587       USER = postmaster@your-domain
#                                       PASSWORD = your Mailgun SMTP password
#   postmark  smtp.postmarkapp.com:587   USER = your Postmark Server API token
#                                       PASSWORD = the same Server API token
#   ses       email-smtp.<region>.amazonaws.com:587
#                                       USER/PASSWORD = SES SMTP credentials
#                                       (set AI_SOC_SMTP_HOST for your region)
#   gmail     smtp.gmail.com:587         USER = your Gmail address
#                                       PASSWORD = a Google App Password
#
# Leave AI_SOC_EMAIL_PROVIDER blank to set host/port manually below.
AI_SOC_EMAIL_PROVIDER=

# Credentials for the chosen provider (obtain them from its dashboard; never
# commit a real .env). The sender must be a verified address/domain.
AI_SOC_SMTP_USER=
AI_SOC_SMTP_PASSWORD=
AI_SOC_SMTP_FROM=AI-SOC <no-reply@example.com>

# Manual overrides — only needed for a region-specific server (e.g. SES) or a
# custom SMTP host. When set, these win over the provider preset.
# AI_SOC_SMTP_HOST=
# AI_SOC_SMTP_PORT=587
# AI_SOC_SMTP_STARTTLS=1

# --- Storage (optional) -------------------------------------------------------
# Defaults to data/processed/auth.db inside the project.
# AI_SOC_AUTH_DB=

# Initial administrator: run `python scripts/provision_admin.py`
# (interactive, hidden password input). No admin credentials live here.